NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://postgres:postgres@localhost:5432/moving_circle_therapy

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=2592000

CORS_ORIGIN=*

# Therapists' working hours are wall-clock times in this timezone.
PRACTICE_TIMEZONE=Australia/Sydney

# Comma-separated emails of the admin accounts (they manage the team).
ADMIN_EMAILS=

# Booking emails to therapists (https://resend.com). Leave blank to skip emails.
RESEND_API_KEY=
EMAIL_FROM="Moving Circle Therapy <bookings@example.com>"
